diff --git a/f2ap/safefetch.py b/f2ap/safefetch.py
new file mode 100644
index 0000000..a570cb9
--- /dev/null
+++ b/f2ap/safefetch.py
@@ -0,0 +1,121 @@
+import ipaddress
+import socket
+
+from urllib.parse import urljoin, urlparse
+
+import requests
+
+# Blocks file://, gopher://, dict://, ftp:// and friends, which are the schemes
+# that turn a URL fetch into a local file read or a protocol-smuggling gadget.
+# Both HTTP and HTTPS stay allowed so that existing peers keep working.
+ALLOWED_SCHEMES = ("http", "https")
+
+# Without a timeout, a URL that never answers keeps the request handler alive.
+# post_inbox is an async def, so one hanging fetch blocks the event loop.
+FETCH_TIMEOUT = 10
+
+# Redirects are followed, because redirecting actor URLs and delegated
+# WebFinger are both normal in the Fediverse. Every hop is re-validated, so a
+# peer cannot use a redirect to point the server at its own network.
+MAX_REDIRECTS = 5
+_REDIRECT_STATUSES = (301, 302, 303, 307, 308)
+
+
+class UnsafeUrlError(ValueError):
+    """Raised when a URL must not be fetched by the server."""
+
+
+# ipaddress does not report these as private, but a server must not be talked
+# into reaching them: 100.64.0.0/10 is RFC 6598 carrier-grade NAT, which is also
+# Tailscale's default range, and 64:ff9b::/96 is the well-known NAT64 prefix that
+# maps arbitrary IPv4 addresses - including 127.0.0.1 - into IPv6.
+EXTRA_PRIVATE_NETWORKS = (
+    ipaddress.ip_network("100.64.0.0/10"),
+    ipaddress.ip_network("64:ff9b::/96"),
+    ipaddress.ip_network("64:ff9b:1::/48"),
+)
+
+
+def _is_public_address(ip: str) -> bool:
+    address = ipaddress.ip_address(ip)
+
+    # An IPv4-mapped IPv6 address must be judged on the IPv4 address it carries.
+    mapped = getattr(address, "ipv4_mapped", None)
+    if mapped is not None:
+        address = mapped
+
+    if any(address in network for network in EXTRA_PRIVATE_NETWORKS):
+        return False
+
+    return not (
+        address.is_private
+        or address.is_loopback
+        or address.is_link_local
+        or address.is_multicast
+        or address.is_reserved
+        or address.is_unspecified
+    )
+
+
+def assert_safe_url(url) -> None:
+    """Refuse URLs that would make the server talk to itself or to a private network."""
+    if not isinstance(url, str) or url == "":
+        raise UnsafeUrlError("No URL given.")
+
+    parsed = urlparse(url)
+
+    if parsed.scheme not in ALLOWED_SCHEMES:
+        raise UnsafeUrlError(f"Scheme {parsed.scheme} is not allowed.")
+
+    if parsed.hostname is None:
+        raise UnsafeUrlError("The URL has no host name.")
+
+    default_port = 443 if parsed.scheme == "https" else 80
+
+    try:
+        addresses = socket.getaddrinfo(
+            parsed.hostname, parsed.port or default_port, proto=socket.IPPROTO_TCP
+        )
+    except socket.gaierror as e:
+        raise UnsafeUrlError(f"Could not resolve {parsed.hostname}.") from e
+
+    for address in addresses:
+        if not _is_public_address(address[4][0]):
+            raise UnsafeUrlError(f"{parsed.hostname} resolves to a non-public address.")
+
+
+def _request(method: str, url: str, **kwargs) -> requests.Response:
+    """Perform a request, validating the URL of every redirect hop as well.
+
+    requests' own redirect handling would follow a Location header to an
+    address that was never checked, so redirects are followed one hop at a
+    time here with assert_safe_url applied to each new URL.
+    """
+    kwargs.setdefault("timeout", FETCH_TIMEOUT)
+    kwargs["allow_redirects"] = False
+
+    for _ in range(MAX_REDIRECTS + 1):
+        assert_safe_url(url)
+        response = requests.request(method, url, **kwargs)
+
+        location = response.headers.get("location")
+        if response.status_code not in _REDIRECT_STATUSES or location is None:
+            return response
+
+        url = urljoin(url, location)
+
+        # 303, and in practice 301 and 302, turn a POST into a GET.
+        if method.lower() == "post" and response.status_code in (301, 302, 303):
+            method = "get"
+            kwargs.pop("data", None)
+            kwargs.pop("json", None)
+
+    raise UnsafeUrlError(f"More than {MAX_REDIRECTS} redirects.")
+
+
+def get(url: str, **kwargs) -> requests.Response:
+    return _request("get", url, **kwargs)
+
+
+def post(url: str, **kwargs) -> requests.Response:
+    return _request("post", url, **kwargs)
